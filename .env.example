# OpenGEO 开源前端 — 复制为 .env.local（npm run dev 自动加载）
# 仅保留本地跑通所需项。

# 【必填】开源后端 API 基址（勿加 /api 后缀；须与 uvicorn --port 一致）
VITE_API_BASE_URL=http://localhost:8002

# 与云端 backend OPTIMIZATION_OPS_MODE 保持一致：manual_ops|content_publish（或 b|a）
# manual_ops = B：发布设置 + 定额扣费；content_publish = A：范文/仿写 + 三方发稿
VITE_OPTIMIZATION_OPS_MODE=manual_ops
