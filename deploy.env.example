# 复制为 deploy.env（服务器 /home/saas/deploy.env）
# 证书已签：/etc/letsencrypt/live/makestoryforge.com/
# 直接 bash deploy-static.sh 即可，下列为显式配置示例（与脚本默认值一致）

TENANT_WILDCARD_DOMAIN=makestoryforge.com
MAIN_SERVER_NAME=saas.makestoryforge.com

SSL_CERT_PATH=/etc/letsencrypt/live/makestoryforge.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/makestoryforge.com/privkey.pem
SUBSITE_SSL_CERT_PATH=/etc/letsencrypt/live/makestoryforge.com/fullchain.pem
SUBSITE_SSL_KEY_PATH=/etc/letsencrypt/live/makestoryforge.com/privkey.pem

BACKEND_ORIGIN=https://ai.gaobobo.cn
BACKEND_PROXY_HOST=ai.gaobobo.cn

# 与 saas/.env.server、backend/.env 保持一致；子站静态页联系表单写入此地址
PUBLIC_API_BASE_URL=https://ai.gaobobo.cn

# 若 subsite_cache 在 backend 宿主机，从 ai.gaobobo.cn SSH 拉取（每小时）
# BACKEND_RSYNC_SSH=deploy@47.99.191.166
# SETUP_RSYNC_CRON=true
# RSYNC_CRON_SCHEDULE="0 * * * *"
